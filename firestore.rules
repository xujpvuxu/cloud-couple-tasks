rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function pairExists(pairId) {
      return exists(/databases/$(database)/documents/pairs/$(pairId));
    }
    function isPairMember(pairId) {
      return signedIn() && pairExists(pairId) &&
        (get(/databases/$(database)/documents/pairs/$(pairId)).data.ownerId == request.auth.uid ||
         get(/databases/$(database)/documents/pairs/$(pairId)).data.partnerId == request.auth.uid);
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid &&
        request.resource.data.points == 0;
      allow read: if signedIn() && (request.auth.uid == uid ||
        (resource.data.pairId != null && isPairMember(resource.data.pairId)));
      allow update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.points == resource.data.points &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'pairId', 'partnerId']);
      allow delete: if false;
    }

    match /pairs/{pairId} {
      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.partnerId == null;
      allow read: if isPairMember(pairId) ||
        (signedIn() && resource.data.partnerId == null &&
         resource.data.expiresAt is timestamp && resource.data.expiresAt > request.time);
      allow update: if signedIn() &&
        resource.data.ownerId != request.auth.uid &&
        resource.data.partnerId == null &&
        request.resource.data.partnerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.expiresAt == resource.data.expiresAt &&
        resource.data.expiresAt > request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerId']);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid &&
        resource.data.partnerId == null;

      match /rewards/{rewardId} {
        function validReward(data) {
          return data.keys().hasOnly(['title', 'points', 'emoji', 'createdAt', 'updatedAt']) &&
            data.title is string && data.title.size() > 0 && data.title.size() <= 60 &&
            data.points is int && data.points >= 0 && data.points <= 9999 &&
            data.emoji is string && data.emoji.size() <= 8;
        }
        allow read: if isPairMember(pairId);
        allow create: if isPairMember(pairId) && validReward(request.resource.data);
        allow update: if isPairMember(pairId) && validReward(request.resource.data) &&
          request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isPairMember(pairId);
      }

      match /redemptions/{redemptionId} {
        function validRedemption(data) {
          return data.keys().hasOnly(['pairId', 'rewardId', 'title', 'emoji', 'points', 'requesterId', 'approverId', 'status', 'createdAt']) &&
            data.pairId == pairId && data.rewardId is string &&
            data.title is string && data.title.size() > 0 &&
            data.emoji is string && data.points is int && data.points >= 0 &&
            data.requesterId == request.auth.uid && data.approverId is string &&
            data.approverId != request.auth.uid &&
            data.approverId in [
              get(/databases/$(database)/documents/pairs/$(pairId)).data.ownerId,
              get(/databases/$(database)/documents/pairs/$(pairId)).data.partnerId
            ] && data.status == 'pending' && data.createdAt is timestamp &&
            exists(/databases/$(database)/documents/pairs/$(pairId)/rewards/$(data.rewardId)) &&
            get(/databases/$(database)/documents/pairs/$(pairId)/rewards/$(data.rewardId)).data.title == data.title &&
            get(/databases/$(database)/documents/pairs/$(pairId)/rewards/$(data.rewardId)).data.emoji == data.emoji &&
            get(/databases/$(database)/documents/pairs/$(pairId)/rewards/$(data.rewardId)).data.points == data.points;
        }
        allow read: if isPairMember(pairId);
        allow create: if isPairMember(pairId) && validRedemption(request.resource.data);
        allow update: if isPairMember(pairId) &&
          resource.data.status == 'pending' &&
          request.auth.uid == resource.data.approverId &&
          request.resource.data.status in ['approved', 'rejected'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt']);
        allow delete: if false;
      }

      match /settings/{settingId} {
        allow read: if isPairMember(pairId);
        function validDate(value) {
          return value is string && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
        }
        function validCoupleDates(data) {
          let pair = get(/databases/$(database)/documents/pairs/$(pairId)).data;
          return data.keys().hasOnly(['togetherDate', 'birthdays', 'updatedBy', 'updatedAt']) &&
            pair.partnerId is string &&
            validDate(data.togetherDate) && data.birthdays is map &&
            data.birthdays.keys().hasOnly([pair.ownerId, pair.partnerId]) &&
            validDate(data.birthdays[pair.ownerId]) &&
            validDate(data.birthdays[pair.partnerId]) &&
            data.updatedBy == request.auth.uid && data.updatedAt is timestamp;
        }
        allow create: if isPairMember(pairId) && (
          (settingId == 'rewards' &&
            request.resource.data.keys().hasOnly(['initialized', 'createdAt']) &&
            request.resource.data.initialized == true) ||
          (settingId == 'dates' && validCoupleDates(request.resource.data))
        );
        allow update: if isPairMember(pairId) && settingId == 'dates' &&
          validCoupleDates(request.resource.data);
        allow delete: if false;
      }

      match /tasks/{taskId} {
        allow read: if isPairMember(pairId);
        allow create: if isPairMember(pairId) &&
          request.resource.data.pairId == pairId &&
          request.resource.data.status == 'open' &&
          (
            (request.resource.data.creatorId == request.auth.uid &&
              request.resource.data.receiverId != request.auth.uid &&
              request.resource.data.receiverId in [
                get(/databases/$(database)/documents/pairs/$(pairId)).data.ownerId,
                get(/databases/$(database)/documents/pairs/$(pairId)).data.partnerId
              ]) ||
            (request.resource.data.kind == '每日固定' &&
              request.resource.data.receiverId == request.auth.uid &&
              request.resource.data.rootId is string &&
              request.resource.data.cycle is string &&
              exists(/databases/$(database)/documents/pairs/$(pairId)/tasks/$(request.resource.data.rootId)) &&
              get(/databases/$(database)/documents/pairs/$(pairId)/tasks/$(request.resource.data.rootId)).data.rootId == request.resource.data.rootId &&
              get(/databases/$(database)/documents/pairs/$(pairId)/tasks/$(request.resource.data.rootId)).data.creatorId == request.resource.data.creatorId &&
              get(/databases/$(database)/documents/pairs/$(pairId)/tasks/$(request.resource.data.rootId)).data.receiverId == request.auth.uid)
          );
        allow update: if isPairMember(pairId) &&
          request.resource.data.pairId == resource.data.pairId &&
          request.resource.data.creatorId == resource.data.creatorId &&
          request.resource.data.receiverId == resource.data.receiverId &&
          (
            (resource.data.status == 'open' &&
              request.resource.data.status == 'review' &&
              request.auth.uid == resource.data.receiverId &&
              ((resource.data.rewardType == 'random' &&
                request.resource.data.roll is int &&
                request.resource.data.roll >= 0 &&
                request.resource.data.roll <= 10) ||
               (resource.data.rewardType != 'random' &&
                request.resource.data.roll == resource.data.points)) &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'roll', 'completedAt'])) ||
            (resource.data.status == 'rejected' &&
              request.resource.data.status == 'open' &&
              request.auth.uid == resource.data.receiverId &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'rejectReason', 'acknowledgedAt'])) ||
            (resource.data.status == 'review' &&
              request.resource.data.status == 'done' &&
              request.auth.uid == resource.data.creatorId &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'reviewedAt'])) ||
            (resource.data.status == 'review' &&
              request.resource.data.status == 'rejected' &&
              request.auth.uid == resource.data.creatorId &&
              request.resource.data.rejectReason is string &&
              request.resource.data.rejectReason.size() > 0 &&
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'rejectReason', 'rejectedAt']))
          );
        allow delete: if isPairMember(pairId) &&
          request.auth.uid == resource.data.creatorId &&
          resource.data.status == 'open';
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
